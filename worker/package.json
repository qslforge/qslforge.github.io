{
  "name": "@qslforge/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply qslforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply qslforge --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qslforge/shared": "workspace:*",
    "hono": "^4.13.23",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "vitest": "4.1.12",
    "wrangler": "^4.168.0"
  }
}
